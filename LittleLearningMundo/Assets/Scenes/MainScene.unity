    projectionSteps:
    - quad: {fileID: 183885899}
      image: {fileID: 21300000, guid: 09c0b4397bd87ce4397f6c35aa9f9f2f, type: 3}
      cameraNode: {fileID: 2010933112}
      imageDescription: 
      hasQuestion: 0
      questionPrompt: "\u8ACB\u6839\u64DA\u6558\u8FF0\u5167\u5BB9\u51FA\u4E00\u500B\u7C21\u55AE\u7684\u9078\u64C7\u984C\u3002"
  - locationID: EL
    useAISummary: 1
    baseIntroduction: "\u3010\u5B98\u65B9\u5275\u4F5C\u8005\u7406\u5FF5\u3011\n\n\u5730\u7406\u4F4D\u7F6E\uFF1A\u5EA7\u843D\u65BC\u570B\u7ACB\u6210\u529F\u5927\u5B78\u8CC7\u8A0A\u5DE5\u7A0B\u5B78\u7CFB\u9928\uFF08\u8CC7\u5DE5\u7CFB\uFF09\u8207\u8CC7\u6E90\u5DE5\u7A0B\u5B78\u7CFB\u9928\uFF08\u8CC7\u6E90\u7CFB\uFF09\u4E4B\u9593\u7684\u8349\u576A\u5EE3\u5834\u4E0A\u3002\n\n\u9020\u578B\u8207\u610F\u8C61\uFF1A\u672C\u4F5C\u54C1\u70BA\u4E00\u5EA7\u591A\u89D2\u578B\u7684\u7ACB\u9AD4\u88DD\u7F6E\u85DD\u8853\uFF0C\u4E3B\u9AD4\u4EE5\u5149\u8292\u56DB\u5C04\u7684\u9BAE\u9EC3\u8272\u5E7E\u4F55\u9020\u578B\u5448\u73FE\uFF0C\u8C61\u5FB5\u8457\u300C\u5149\u660E\u8207\u6C38\u6046\u7684\u529B\u91CF\u300D\u3002\n\n\u8996\u89BA\u5F35\u529B\uFF1A\u5DE8\u5927\u4E14\u5448\u653E\u5C04\u72C0\u69CB\u6210\u7684\u5EFA\u7BC9\u91CF\u9AD4\uFF0C\u5177\u5099\u6975\u5F37\u7684\u7ACB\u9AD4\u9020\u578B\u7F8E\u611F\uFF0C\u8207\u7A7F\u68AD\u5176\u9593\u7684\u4EBA\u7FA4\u5F62\u6210\u6709\u8DA3\u7684\u6BD4\u4F8B\u5C0D\u6BD4\u3002\u7576\u6E05\u6668\u4F86\u81E8\u6642\uFF0C\u5B83\u8207\u6771\u6607\u7684\u65ED\u65E5\u76F8\u4E92\u8F1D\u6620\uFF0C\u5728\u6821\u5712\u4E2D\u5F62\u6210\u5982\u671D\u967D\u822C\u5145\u6EFF\u671D\u6C23\u7684\u8996\u89BA\u65B0\u610F\u8C61\u3002\n\n\u3010\u6210\u5927\u5B78\u751F\u5728\u5730\u6587\u5316\u8207\u751F\u6D3B\u5BE6\u6CC1\u3011\n\n\u6821\u5712\u4FD7\u7A31\uFF08\u8FF7\u56E0\uFF09\uFF1A\u5118\u7BA1\u5B98\u65B9\u540D\u7A31\u70BA\u5BCC\u6709\u8A69\u610F\u7684\u300C\u6C38\u6046\u4E4B\u5149\u300D\uFF0C\u4F46\u5728\u6210\u5927\uFF08\u5C24\u5176\u662F\u8CC7\u5DE5\u7CFB\u8207\u8CC7\u6E90\u7CFB\uFF09\u7684\u5B78\u751F\u53E3\u4E2D\uFF0C\u56E0\u5176\u7368\u7279\u7684\u653E\u5C04\u72C0\u9BAE\u9EC3\u8272\u5916\u89C0\uFF0C\u6240\u6709\u4EBA\u7686\u89AA\u5207\u4E14\u76F4\u767D\u5730\u7A31\u547C\u5B83\u70BA\u300C\u9EC3\u8272\u6D77\u81BD\u300D\u3002\n\n\u591C\u9593\u751F\u6D3B\u5834\u666F\uFF1A\u8A72\u88DD\u7F6E\u85DD\u8853\u5F8C\u65B9\u7DCA\u9130\u5929\u6A4B\uFF0C\u5929\u6A4B\u4E0B\u65B9\u5EF6\u4F38\u51FA\u7684\u5EE3\u5834\u6BCF\u5929\u5165\u591C\u5F8C\uFF0C\u7D93\u5E38\u53EF\u4EE5\u770B\u5230\u6210\u5927\u5B78\u751F\u8207\u5404\u985E\u793E\u5718\u5728\u6B64\u805A\u96C6\uFF0C\u8457\u71C8\u5149\u8207\u97F3\u6A02\uFF0C\u63EE\u6C57\u5982\u96E8\u5730\u52AA\u529B\u7DF4\u7FD2\u5404\u7A2E\u6D3B\u52D5\u7684\u8857\u821E\u3001\u706B\u821E\u6216\u6232\u5287\u8868\u6F14\uFF0C\u662F\u5C55\u73FE\u6210\u5927\u9752\u6625\u6D3B\u529B\u7684\u6A19\u8A8C\u6027\u7A7A\u9593\u3002"
    cinematicCameraNode: {fileID: 963194228}
