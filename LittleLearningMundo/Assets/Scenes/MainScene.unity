--- !u!114 &1336584338
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1336584337}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3b48a1cd78c958a47879bfae4783ab30, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  storyTitle: "\u5C0E\u89BD\u5287\u672C"
  responsibleNPCName: Carol
  endStoryDialogue: "\u5C0E\u89BD\u884C\u7A0B\u7D50\u675F\u56C9\uFF01"
  noteTitle: "\u6E2C\u8A66\u7B46\u8A18"
  noteCoverImage: {fileID: 21300000, guid: 09c0b4397bd87ce4397f6c35aa9f9f2f, type: 3}
  noteContent: "\u597D\u68D2\u5594Yeah"
  steps:
  - locationID: OPHY
    useAISummary: 1
    baseIntroduction: "\u95DC\u65BC\uFF1A\u6210\u5927\u7269\u7406\u7CFB\u820A\u9928\uFF08\u7406\u5B78\u6559\u5B78\u5927\u6A13\uFF09\n1.
      \u5EFA\u7BC9\u6982\u6CC1\u8207\u6B77\u53F2\u80CC\u666F\n\u8208\u5EFA\u5E74\u4EE3\uFF1A
      \u5B8C\u5DE5\u65BC 1959 \u5E74\uFF0C\u7531\u6210\u5927\u5EFA\u7BC9\u7CFB\u5275\u7CFB\u4E3B\u4EFB\u6731\u5C0A\u8ABC\u6559\u6388\u8A2D\u8A08\u3002\n\n\u5EFA\u7BC9\u5B9A\u4F4D\uFF1A
      \u8A72\u5EFA\u7BC9\u4EE3\u8868\u4E86\u53F0\u7063\u6230\u5F8C\u521D\u671F\uFF081950
      \u5E74\u4EE3\uFF09\u6821\u5712\u5EFA\u7BC9\u7684\u8F49\u6298\uFF0C\u627F\u8972\u4E86\u65E5\u6CBB\u6642\u671F\u7D05\u78DA\u6821\u820D\u7684\u8272\u8ABF\uFF0C\u4F46\u5728\u9020\u578B\u4E0A\u9081\u5411\u73FE\u4EE3\u4E3B\u7FA9\u7684\u7C21\u6F54\u8207\u6A5F\u80FD\u5316\u3002\n\n\u529F\u80FD\u6F14\u8B8A\uFF1A
      \u539F\u70BA\u7269\u7406\u5B78\u7CFB\u4E4B\u6559\u5B78\u8207\u5BE6\u9A57\u6838\u5FC3\uFF0C\u73FE\u66F4\u540D\u70BA\u300C\u7406\u5B78\u6559\u5B78\u5927\u6A13\u300D\uFF0C\u4E3B\u8981\u4F5C\u70BA\u666E\u901A\u7269\u7406\u5BE6\u9A57\u5BA4\u53CA\u7406\u5B78\u9662\u8DE8\u7CFB\u6240\u6559\u5B78\u7A7A\u9593\u3002\n\n\u7A7A\u9593\u908F\u8F2F\uFF1A
      \u63A1\u55AE\u5074\u8D70\u5ECA\u914D\u7F6E\uFF0C\u5F37\u8ABF\u63A1\u5149\u8207\u81EA\u7136\u5C0D\u98A8\uFF0C\u9069\u61C9\u53F0\u5357\u708E\u71B1\u6C23\u5019\u3002\u5167\u90E8\u4FDD\u7559\u5927\u91CF\u78E8\u77F3\u5B50\u5730\u677F\u8207\u5782\u76F4\u683C\u67F5\u7A97\u666F\u3002"
    cinematicCameraNode: {fileID: 1285852847}
    projectionSteps:
    - quad: {fileID: 362562937}
      image: {fileID: 21300000, guid: 09c0b4397bd87ce4397f6c35aa9f9f2f, type: 3}
      cameraNode: {fileID: 1367573490}
      imageDescription: "\u6B64\u7167\u7247\u5448\u73FE\u7269\u7406\u7CFB\u820A\u9928\u5F8C\u65B9\u6216\u5074\u908A\u7684\u5EAD\u5712\u914D\u7F6E\uFF0C\u5C55\u73FE\u5EFA\u7BC9\u8207\u690D\u683D\u7684\u7A7A\u9593\u95DC\u4FC2\u3002\n\n\u666F\u89C0\u69CB\u9020\uFF1A
        \u756B\u9762\u4E2D\u5FC3\u70BA\u4E00\u8655\u5713\u5F62\u4F4E\u77EE\u78DA\u7246\u666F\u89C0\u6C60\uFF0C\u6C60\u5167\u5806\u758A\u5927\u91CF\u4E0D\u898F\u5247\u6DF1\u8272\u5CA9\u77F3\uFF08\u5047\u5C71\uFF09\uFF0C\u6C60\u5468\u908A\u8A2D\u6709\u91D1\u5C6C\u7BA1\u7DDA\u8207\u6DF7\u51DD\u571F\u57FA\u5EA7\u3002\n\n\u5EFA\u7BC9\u5916\u89C0\uFF1A
        \u53F3\u5074\u70BA\u7D05\u78DA\u780C\u7BC9\u7684\u4E00\u5C64\u6A13\u5E73\u623F\uFF0C\u5C4B\u9802\u8986\u84CB\u7070\u9ED1\u8272\u74E6\u7247\u3002\u7246\u9762\u53EF\u898B\u660E\u986F\u7684\u5782\u76F4\u6392\u6C34\u7BA1\uFF0C\u4EE5\u53CA\u5169\u90E8\u4E26\u6392\u5B89\u88DD\u7684\u767D\u8272\u7A7A\u8ABF\u5BA4\u5916\u6A5F\u3002\n\n\u690D\u683D\u5206\u4F48\uFF1A
        \u5EAD\u5712\u5167\u8986\u84CB\u8349\u576A\uFF0C\u6563\u843D\u4FEE\u526A\u6210\u5713\u7403\u72C0\u7684\u77EE\u704C\u6728\u3002\u5DE6\u5074\u8207\u4E0A\u65B9\u6709\u8302\u5BC6\u7684\u5927\u578B\u55AC\u6728\uFF08\u5982\u6995\u6A39\u6216\u8304\u82F3\uFF09\uFF0C\u967D\u5149\u7A7F\u900F\u6A39\u852D\u5F62\u6210\u660E\u986F\u7684\u5149\u6688\u3002\n\n\u80CC\u666F\uFF1A
        \u9060\u65B9\u53EF\u898B\u73FE\u4EE3\u5316\u7684\u92FC\u7B4B\u6DF7\u51DD\u571F\u5EFA\u7BC9\uFF0C\u8207\u8FD1\u666F\u7684\u7D05\u78DA\u74E6\u623F\u5F62\u6210\u65B0\u820A\u5C0D\u6BD4\u3002"
      hasQuestion: 1
      questionPrompt: "\u8ACB\u6839\u64DA\u6558\u8FF0\u5167\u5BB9\u51FA\u4E00\u500B\u7C21\u55AE\u7684\u9078\u64C7\u984C\u3002"
    - quad: {fileID: 1096319273}
      image: {fileID: 21300000, guid: b9a77eb5355a66f40b230b63d1b5d2dc, type: 3}
      cameraNode: {fileID: 1647131623}
      imageDescription: "\u6B64\u7167\u7247\u70BA\u8A72\u5EFA\u7BC9\u6A19\u6E96\u55AE\u5143\u7ACB\u9762\u7684\u6B63\u8996\u5716\uFF0C\u5C55\u793A\u7D30\u90E8\u6750\u6599\u8207\u8272\u5F69\u7279\u5FB5\u3002\n\n\u7246\u9762\u6750\u8CEA\uFF1A
        \u7246\u9AD4\u4E3B\u9AD4\u7531\u7D05\u78DA\u5782\u76F4\u780C\u7BC9\uFF0C\u5E95\u90E8\u63A5\u58E4\u7D04
        50 \u516C\u5206\u9AD8\u7684\u6DFA\u8272\u6D17\u77F3\u5B50\u6216\u6C34\u6CE5\u7C89\u5237\u57FA\u5EA7\u3002\n\n\u958B\u53E3\u90E8\u8A2D\u8A08\uFF1A
        * \u9580\u6247\uFF1A \u4E2D\u5FC3\u70BA\u96D9\u958B\u5F0F\u6728\u8CEA\u5927\u9580\uFF0C\u5857\u88DD\u70BA\u7279\u5B9A\u7684\u6DFA\u85CD\u8272\uFF08\u6821\u5712\u8B58\u5225\u8272\u5F69\uFF09\uFF0C\u9580\u4E0A\u534A\u90E8\u9472\u5D4C\u900F\u660E\u73BB\u7483\u3002\n\n\u7A97\u6236\uFF1A
        \u5165\u53E3\u5169\u5074\u5C0D\u7A31\u6392\u5217\u9577\u65B9\u5F62\u63A8\u62C9\u7A97\uFF0C\u7A97\u6846\u5747\u70BA\u6DFA\u85CD\u8272\uFF0C\u4E0A\u65B9\u8A2D\u6709\u56FA\u5B9A\u5F0F\u7684\u63A1\u5149\u6C23\u7A97\u3002\n\n\u96E8\u906E\u8207\u7D30\u90E8\uFF1A
        \u9580\u4E0A\u65B9\u8A2D\u6709\u6C34\u5E73\u5F0F\u6C34\u6CE5\u96E8\u906E\uFF0C\u7531\u5169\u8655\u88DD\u98FE\u6027\u6258\u5EA7\u652F\u6490\u3002\u9580\u65C1\u639B\u6709\u4E00\u584A\u6DFA\u7070\u8272\u5927\u7406\u77F3\u6750\u8CEA\u7684\u7CFB\u9928\u9298\u724C\u3002\n\n\u5730\u9762\u8A2D\u65BD\uFF1A
        \u9580\u524D\u8A2D\u6709\u4E09\u7D1A\u6C34\u6CE5\u968E\u68AF\uFF0C\u929C\u63A5\u4E00\u689D\u6A6B\u5411\u92EA\u8A2D\u7684\u6728\u68E7\u9053\u3002\n\n\u690D\u683D\uFF1A
        \u5165\u53E3\u53F3\u5074\u7A2E\u690D\u4E00\u682A\u9AD8\u5927\u7684\u68D5\u6ADA\u79D1\u690D\u7269\uFF08\u9CF3\u51F0\u6728\u6216\u985E\u4F3C\u6A39\u7A2E\uFF09\uFF0C\u6A39\u5E79\u5411\u53F3\u4E0A\u65B9\u50BE\u659C\uFF0C\u8207\u5782\u76F4\u7684\u5EFA\u7BC9\u7DDA\u689D\u5F62\u6210\u8996\u89BA\u5F35\u529B\u3002"
      hasQuestion: 0
      questionPrompt: "\u8ACB\u6839\u64DA\u7167\u7247\u5167\u5BB9\u51FA\u4E00\u500B\u7C21\u55AE\u7684\u9078\u64C7\u984C\u3002"
  - locationID: CSIE
    useAISummary: 1
    baseIntroduction: "\u6210\u529F\u5927\u5B78\u6821\u5712\u5730\u666F\u8207\u6587\u5316\u77E5\u8B58\uFF1A\u8CC7\u8A0A\u5DE5\u7A0B\u5B78\u7CFB\u820A\u9928
      (CSIE Old Building)\n\n\u3010\u7A7A\u9593\u5B9A\u4F4D\u8207\u57FA\u790E\u5B78\u8853\u6A1E\u7D10\u3011\n\n\u57FA\u790E\u8AB2\u7A0B\u4FEE\u7149\u5730\uFF1A\u8CC7\u8A0A\u7CFB\u820A\u9928\u662F\u5927\u5B78\u90E8\u5B78\u751F\u624E\u6839\u6838\u5FC3\u5B78\u79D1\u7684\u57FA\u5730\u3002\u9019\u88E1\u627F\u8F09\u8457\u7A0B\u5F0F\u8A2D\u8A08\u3001\u8CC7\u6599\u7D50\u69CB\u3001\u6F14\u7B97\u6CD5\u7B49\u57FA\u790E\u8AB2\u7A0B\u7684\u6559\u5B78\u91CD\u4EFB\u3002\u9928\u5167\u898F\u5283\u4E86\u8A31\u591A\u5C0F\u6559\u5BA4\u8207\u8A0E\u8AD6\u5BA4\uFF0C\u662F\u8CC7\u5DE5\u7CFB\u5B78\u751F\u5C0F\u7D44\u5408\u4F5C\u3001\u8A0E\u8AD6\u5C08\u984C\u4EE5\u53CA\u760B\u72C2
      Debug \u7684\u6838\u5FC3\u5834\u6240\u3002\n\n\u4E2D\u5EAD\u6C34\u6C60\u666F\u89C0\uFF1A\u820A\u9928\u7684\u6838\u5FC3\u5340\u57DF\u5167\u64C1\u6709\u4E00\u5EA7\u975C\u8B10\u7684\u4E2D\u5EAD\u6C34\u6C60\u3002\u767D\u5929\u967D\u5149\u7051\u843D\u6642\uFF0C\u6C34\u9762\u8207\u5468\u570D\u7684\u7D05\u78DA\u9577\u5ECA\u4EA4\u76F8\u8F1D\u6620\uFF0C\u662F\u5B78\u751F\u8AB2\u5F8C\u653E\u9B06\u3001\u8212\u7DE9\u5BEB\u4EE3\u78BC\u75B2\u52DE\u7684\u79D8\u5BC6\u82B1\u5712\u3002\n\n\u3010\u65E5\u591C\u4EA4\u66FF\u7684\u6D3B\u529B\u8F49\u8B8A\u3011\n\n\u767D\u5929\u7684\u5B78\u8853\u6BBF\u5802\uFF1A\u65E9\u4E0A\u7684\u820A\u9928\u5145\u6EFF\u4E86\u5B78\u8853\u6C23\u606F\uFF0C\u8B1B\u5802\u5167\u8FF4\u76EA\u8457\u6559\u6388\u7684\u6388\u8AB2\u8072\u3001\u7C89\u7B46\u5283\u904E\u9ED1\u677F\u7684\u8072\u97F3\u4EE5\u53CA\u7121\u6578\u9375\u76E4\u6572\u64CA\u7684\u7A0B\u5F0F\u78BC\u594F\u9CF4\u66F2\u3002\n\n\u591C\u665A\u7684\u6D3B\u52D5\u57FA\u5730\uFF1A\u591C\u5E55\u4F4E\u5782\u5F8C\uFF0C\u9019\u88E1\u892A\u53BB\u56B4\u8085\u7684\u5B78\u8853\u5916\u8863\uFF0C\u6416\u8EAB\u4E00\u8B8A\u6210\u70BA\u5B78\u751F\u6D3B\u52D5\u7684\u767C\u6E90\u5730\u3002\u5404\u500B\u8BA8\u8BBA\u5BA4\u8207\u4E2D\u5EAD\u71C8\u706B\u901A\u660E\uFF0C\u8CC7\u5DE5\u7CFB\u5B78\u6703\u3001\u71DF\u968A\u3001\u8CC7\u5DE5\u4E4B\u591C\u7B49\u5404\u7A2E\u7CBE\u5F69\u6D3B\u52D5\u7684\u7C4C\u5099\u8207\u6392\u7DF4\u90FD\u5728\u6B64\u71B1\u70C8\u5C55\u958B\uFF0C\u5145\u6EFF\u9752\u6625\u8207\u7B11\u8072\u3002\n\n\u3010\u6EAB\u99A8\u7684\u51AC\u65E5\u50B3\u7D71\u6587\u5316\u3011\n\n\u6696\u5FC3\u706B\u934B\u6703\u8207\u6E6F\u5713\u6703\uFF1A\u6BCF\u5E74\u51AC\u5929\uFF08\u901A\u5E38\u5728\u51AC\u81F3\u8207\u5BD2\u51B7\u7684\u671F\u672B\u8003\u5B63\u524D\u5915\uFF09\uFF0C\u7CFB\u5B78\u6703\u90FD\u6703\u5728\u820A\u9928\u8209\u8FA6\u4E00\u5E74\u4E00\u5EA6\u7684\u706B\u934B\u6703\u8207\u6E6F\u5713\u6703\u3002\n\n\u9019\u500B\u6EAB\u99A8\u7684\u50B3\u7D71\u65E8\u5728\u8B93\u5E73\u6642\u5FD9\u65BC\u8AB2\u696D\u3001\u88AB\u7A0B\u5F0F\u78BC\u8F5F\u70B8\u7684\u540C\u5B78\u5011\u805A\u5728\u4E00\u8D77\uFF0C\u570D\u8457\u71B1\u6C23\u9A30\u9A30\u7684\u934B\u5B50\u5403\u8089\u804A\u5929\u3001\u559D\u4E00\u7897\u751C\u6ECB\u6ECB\u7684\u6E6F\u5713\u3002\u9019\u4E0D\u50C5\u9A45\u6563\u4E86\u51AC\u591C\u7684\u5BD2\u610F\uFF0C\u66F4\u5728\u7DCA\u7E43\u7684\u8003\u524D\u6EAB\u6696\u4E86\u6BCF\u4E00\u4F4D\u8CC7\u5DE5\u5B78\u751F\u7684\u80C3\u8207\u5FC3\u3002"
