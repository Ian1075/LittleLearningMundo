--- !u!114 &9114350
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 9114349}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3b48a1cd78c958a47879bfae4783ab30, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  storyTitle: "\u5C0E\u89BD\u5287\u672C"
  responsibleNPCName: Pinkman
  endStoryDialogue: "\u5C0E\u89BD\u884C\u7A0B\u7D50\u675F\u56C9\uFF01"
  noteTitle: "\u6E2C\u8A66\u7B46\u8A18"
  noteCoverImage: {fileID: 21300000, guid: 09c0b4397bd87ce4397f6c35aa9f9f2f, type: 3}
  noteContent: "\u597D\u68D2\u5594Yeah"
  steps:
  - locationID: MSE
    useAISummary: 1
    baseIntroduction: "\u672C\u7CFB\u70BA\u6211\u570B\u6700\u65E9\u6210\u7ACB\u57F9\u80B2\u6750\u6599\u79D1\u6280\u4EBA\u624D\u4E4B\u5B78\u8853\u55AE\u4F4D\uFF0C\u6210\u7ACB\u4E4B\u5B97\u65E8\u4E3B\u8981\u5728\u57F9\u80B2\u5404\u7A2E\u6750\u6599\u8A2D\u8A08\u3001\u751F\u7522\u8207\u7814\u767C\u4E4B\u5C08\u696D\u83C1\u82F1\u3002\u56DE\u6EAF\u672C\u7CFB\u767C\u5C55\u7684\u6B77\u53F2\uFF0C\u524D\u8EAB\u4F9D\u5E8F\u6CBF\u9769\u81EA\u300E\u96FB\u6C23\u5316
      \u5B78\u7CFB\u300F\u3001\u300E\u7926\u51B6\u5DE5\u7A0B\u5B78\u7CFB\u300F\u3001\u300E\u7926\u51B6\u53CA\u6750\u6599\u5DE5\u7A0B\u5B78\u7CFB\u300F\u5230\u300E\u6750\u6599\u5DE5\u7A0B\u5B78\u7CFB\u300F\uFF0C\u81F3\u6C11\u570B\u516B\u5341\u4E00\u5E74\u70BA\u8981\u7B26\u5408\u73FE\u6CC1\u53CA\u5229\u65BC\u9577\u7A0B\u767C\u5C55\uFF0C\u9032\u4E00\u6B65\u86FB\u8B8A\u70BA\u300E\u6750\u6599\u79D1\u5B78\u53CA\u5DE5\u7A0B\u5B78
      \u7CFB\u300F\u3002\u81EA\u4E000\u4E00\u5B78\u5E74\u5EA6\u8D77\uFF0C\u672C\u7CFB\u66F4\u6574\u4F75\u672C\u6821\u5DE5\u5B78\u9662\u300E\u5948\u7C73\u79D1\u6280\u66A8\u5FAE\u7CFB\u7D71\u5DE5\u7A0B\u7814\u7A76\u6240\u300F\uFF0C\u4F7F\u672C\u7CFB\u5E2B\u8CC7\u9663\u5BB9\u8207\u7814\u7A76\u9818\u57DF\u66F4\u70BA\u5B8C\u6574\u3002\u6B77\u5E74\u5728\u5E2B\u751F\u7684\u52AA\u529B\u4E0B\uFF0C\u7814\u7A76\u98A8\u6C23\u53CA\u6210\u679C
      \u65BC\u570B\u5167\u6750\u6599\u754C\u4E00\u76F4\u4F54\u6709\u8209\u8DB3\u8F15\u91CD\u7684\u4EFD\u91CF\u3002\u672C\u7CFB\u7684\u5B78\u8853\u7814\u7A76\u9023\u7E8C\u5169\u5E74\u5728\u6821\u5167\u8A55\u6BD4\u7372\u7B2C\u4E00\u540D\uFF0C\u7814\u7A76\u6210\u679C\u4E0D\u50C5\u5728\u91CF\u7684\u65B9\u9762\u8868\u73FE\u512A\u7570\uFF0C\u8CEA\u7684\u8868\u73FE\u8207\u6240\u7372\u7814\u7A76\u8A08\u756B\u7D93\u8CBB\u66F4\u662F\u5168\u6821
      \u4F7C\u4F7C\u8005\u3002\u4F8B\u5982\uFF0C\u672C\u6821\u7372\u5F97\u4E4B\u570B\u79D1\u6703\u516D\u9805\u570B\u5BB6\u578B\u8A08\u756B\u4E2D\uFF0C\u672C\u7CFB\u5373\u56CA\u62EC\u5176\u4E2D\u4E09\u9805\uFF1B\u5168\u6821\u4E09\u9805\u5927\u578B\u7D93\u90E8\u5B78\u754C\u79D1\u5C08\u8A08\u756B\u4E2D\uFF0C\u672C\u7CFB\u4EA6\u57F7\u884C\u5176\u4E2D\u4E00\u9805\u3002\u672C\u7CFB\u9577\u671F\u5C0D\u6821\u53CA\u5357\u81FA\u7063\u9AD8\u79D1
      \u6280\u7522\u696D\u7684\u767C\u5C55\uFF0C\u6709\u8457\u4E0D\u53EF\u78E8\u6EC5\u7684\u8CA2\u737B\u3002\n\n\u672C\u7CFB\u6240\u64C1\u6709\u512A\u826F\u7CFB\u98A8\u3001\u826F\u597D\u5B78\u7FD2\u74B0\u5883\u53CA\u5805\u5F37\u5B8C\u6574\u7684\u5E2B\u8CC7\u9663\u5BB9\uFF0C\u7814\u7A76\u9818\u57DF\u5EE3\u6CDB\u6DB5\u84CB\u50B3\u7D71\u53CA\u5C16\u7AEF\u6750\u6599\uFF0C\u5305\u542B\u91D1\u5C6C\u6750\u6599\u3001\u9676\u74F7\u6750\u6599\u3001\u9AD8\u5206\u5B50\u6750\u6599\u3001\u8907\u5408\u6750\u6599\u5149\u96FB\u53CA\u96FB\u5B50\u6750\u6599\u3001\u751F\u91AB\u6750\u6599\u3001\u80FD\u6E90\u6750\u6599\u3001\u78C1\u6027\u6750\u6599\u3001\u9AD8\u6EAB\u8D85\u5C0E\u6750\u6599\u3001\u8868\u9762\u8655\u7406\u6280\u8853\u3001\u9AD8\u7B49\u6750\u6599\u5206\u6790\u8207\u96FB\u8166\u8F14\u52A9\u8A08\u7B97\u6750\u6599\u79D1\u5B78\u7B49\u3002\n\n\u79D1\u6280\u767C\u5C55\u7684\u7A81\u7834\uFF0C\u5F80\u5F80\u53D6\u6C7A\u65BC\u65B0\u6750\u6599\u7684\u7814\u767C\u3001\u6E2C\u8A66\u548C\u6539\u826F\u3002\u88AB\u570B\u5BB6\u548C\u6C11\u9593\u7522\u696D\u5747\u5217\u70BA\u95DC\u9375\u7684\u6750\u6599\u79D1\u6280\uFF0C\u4E8B\u5BE6\u662F\u6240\u6709\u5DE5\u7A0B\u6280\u8853\u8207
      \u7522\u696D\u7684\u57FA\u790E\uFF0C\u5B83\u662F\u7D50\u5408\u7269\u7406\u3001\u5316\u5B78\u53CA\u6578\u5B78\u7B49\u5B78\u9580\u4E4B\u9F90\u5927\u6574\u5408\u9AD4\uFF0C\u540C\u6642\u517C\u9867\u7406\u8AD6\u57FA\u790E\u8207\u5DE5\u7A0B\u61C9\u7528\uFF0C\u56E0\u6B64\u5728\u9AD8\u79D1\u6280\u7522\u696D\u53CA\u7522\u696D\u5347\u7D1A\u4E2D\u626E\u6F14\u8457\u76F8\u7576\u91CD\u8981\u7684\u5730\u4F4D\u3002\u70BA\u4E86\u56E0\u61C9\u8FD1
      \u5E74\u4E16\u754C\u6F6E\u6D41\u7684\u5FEB\u901F\u8B8A\u9077\u8207\u570B\u5167\u7522\u696D\u74B0\u5883\u66F4\u52D5\uFF0C\u540C\u6642\u66F4\u517C\u9867\u672C\u6821\u9081\u5411\u570B\u969B\u9802\u5C16\u5927\u5B78\u7684\u76EE\u6A19\uFF0C\u672C\u7CFB\u6301\u7E8C\u63A8\u52D5\u8AB2\u7A0B\u91CD\u6574\uFF0C\u8A2D\u5099\u66F4\u65B0\u8207\u570B\u969B\u5316\u7B49\u91CD\u8981\u6539\u9769\uFF0C\u4EE5\u57F9\u80B2\u5B78\u751F\u56E0\u61C9\u672A
      \u4F86\u6750\u6599\u9818\u57DF\u8207\u7522\u696D\u8B8A\u9077\uFF0C\u8207\u4E16\u754C\u9802\u5C16\u6559\u5B78\u53CA\u7814\u7A76\u55AE\u4F4D\u4E26\u99D5\u9F4A\u9A45\u3002"
    cinematicCameraNode: {fileID: 963194228}
    projectionSteps: []
  - locationID: RE
    useAISummary: 1
    baseIntroduction: "\u6210\u529F\u5927\u5B78\u8CC7\u6E90\u5DE5\u7A0B\u5B78\u7CFB\uFF1A\u80CC\u666F\u77E5\u8B58\u8207\u6B77\u53F2\u6CBF\u9769\n\u3010\u6838\u5FC3\u9858\u666F\u8207\u4F7F\u547D\u3011\n\u6210\u529F\u5927\u5B78\u8CC7\u6E90\u5DE5\u7A0B\u5B78\u7CFB\uFF08\u7C21\u7A31\u6210\u5927\u8CC7\u6E90\u7CFB\uFF09\u662F\u57FA\u65BC\u4EBA\u985E\u5C0D\u8CC7\u6E90\u4E4B\u300C\u958B\u767C\u300D\u3001\u300C\u5229\u7528\u300D\u3001\u300C\u518D\u751F\u300D\u8207\u300C\u8655\u7F6E\u300D\u7B49\u6838\u5FC3\u9700\u6C42\u6240\u8A2D\u7ACB\u7684\u9802\u5C16\u6559\u5B78\u8207\u7814\u7A76\u6A5F\u69CB\u3002\u672C\u7CFB\u4EE5\u57F9\u80B2\u8CC7\u6E90\u958B\u767C\u7684\u9AD8\u7D1A\u4EBA\u624D\u3001\u63A8\u52D5\u8CC7\u6E90\u6C38\u7E8C\u767C\u5C55\u4E4B\u793E\u6703\u4F7F\u547D\u70BA\u5DF1\u4EFB\uFF0C\u7814\u7A76\u7BC4\u7587\u6DB5\u84CB\u56DB\u5927\u8CC7\u6E90\u985E\u578B\uFF1A\n\n\u80FD\u6E90\u8CC7\u6E90\n\n\u7926\u7269\u8CC7\u6E90\n\n\u5929\u7136\u8CC7\u6E90\n\n\u518D\u751F\u8CC7\u6E90\n\n\u672C\u7CFB\u64C1\u6709\u5927\u5B78\u90E8\u53CA\u7814\u7A76\u6240\uFF0C\u9812\u6388\u5B78\u58EB\u3001\u78A9\u58EB\u53CA\u535A\u58EB\u5B78\u4F4D\uFF0C\u5177\u5099\u5B8C\u6574\u7684\u9AD8\u7B49\u6559\u80B2\u8207\u7814\u7A76\u9AD4\u7CFB\uFF0C\u5728\u300C\u8CC7\u6E90\u958B\u767C\u8207\u5229\u7528\u300D\u3001\u300C\u7926\u7269\u6750\u6599\u79D1\u5B78\u300D\u4EE5\u53CA\u300C\u8CC7\u6E90\u5FAA\u74B0\u518D\u751F\u300D\u9818\u57DF\u8655\u65BC\u570B\u5167\u9818\u5148\u5730\u4F4D\u3002\n\n\u3010\u7CFB\u53F2\u767C\u5C55\u8108\u7D61\u3011\n\u672C\u7CFB\u6B77\u53F2\u60A0\u4E45\uFF0C\u5176\u524D\u8EAB\u8207\u6F14\u9032\u6B77\u7A0B\u898B\u8B49\u4E86\u53F0\u7063\u5DE5\u696D\u767C\u5C55\u7684\u8F49\u578B\uFF1A\n\n1945\u5E74\uFF1A\u5275\u7ACB\u65BC\u53F0\u7063\u7E3D\u7763\u5E9C\u53F0\u5357\u5DE5\u696D\u5C08\u9580\u5B78\u6821\uFF0C\u521D\u671F\u70BA\u300C\u96FB\u6C23\u5316\u5B78\u7CFB\u300D\u3002\n\n1946\u5E74\uFF1A\u66F4\u540D\u70BA\u53F0\u7063\u7701\u7ACB\u53F0\u5357\u5DE5\u5B78\u9662\u300C\u96FB\u6C23\u5316\u5B78\u7CFB\u300D\u3002\n\n1953\u5E74\uFF1A\u56E0\u61C9\u7522\u696D\u9700\u6C42\u64F4\u5145\uFF0C\u6539\u5236\u70BA\u300C\u7926\u51B6\u5DE5\u7A0B\u5B78\u7CFB\u300D\u3002\n\n1956\u5E74\uFF1A\u96A8\u5B78\u6821\u5347\u683C\uFF0C\u6539\u70BA\u570B\u7ACB\u6210\u529F\u5927\u5B78\u300C\u7926\u51B6\u5DE5\u7A0B\u5B78\u7CFB\u300D\u3002\n\n1967\u5E74\uFF1A\u56E0\u61C9\u5B78\u9580\u64F4\u5C55\uFF0C\u8ABF\u6574\u70BA\u570B\u7ACB\u6210\u529F\u5927\u5B78\u300C\u7926\u51B6\u53CA\u6750\u6599\u79D1\u5B78\u7CFB\u300D\u3002\n\n1974\u5E74\uFF1A\u6B63\u5F0F\u5206\u7CFB\uFF0C\u672C\u7CFB\u7368\u7ACB\u70BA\u570B\u7ACB\u6210\u529F\u5927\u5B78\u5DE5\u5B78\u9662\u300C\u7926\u696D\u53CA\u77F3\u6CB9\u5DE5\u7A0B\u5B78\u7CFB\u300D\u3002\n\n1992\u5E74\uFF08\u6C11\u570B\u516B\u5341\u4E00\u5E74\uFF09\uFF1A\u70BA\u7B26\u5408\u7576\u4EE3\u5168\u7403\u8CC7\u6E90\u6C38\u7E8C\u8207\u74B0\u5883\u4FDD\u8B77\u4E4B\u6642\u4EE3\u8DA8\u52E2\uFF0C\u6B63\u5F0F\u66F4\u540D\u70BA\u300C\u8CC7\u6E90\u5DE5\u7A0B\u5B78\u7CFB\u300D\u4E26\u6CBF\u7528\u81F3\u4ECA\u3002"
